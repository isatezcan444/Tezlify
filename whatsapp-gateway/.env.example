# Tezlify WhatsApp Gateway environment configuration
# Copy to .env and adjust for your deployment.

# Port and bind host for the gateway REST + WS API
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0

# Where the FastAPI backend listens for gateway events
# (the backend exposes /ws/gateway for this purpose)
BACKEND_WS_URL=ws://backend:8000/ws/gateway

# Required shared secret for every gateway REST/WS request and the backend
# event bridge. Must match backend WHATSAPP_GATEWAY_SECRET (minimum 32 bytes).
WHATSAPP_GATEWAY_SECRET=replace-with-at-least-32-random-bytes

# Encryption key used to encrypt persisted Baileys auth state at rest
# MUST be a strong secret in production (min 32 chars).
GATEWAY_ENCRYPTION_KEY=

# Standard PostgreSQL URL (not postgresql+asyncpg). Used for durable auth
# and session state storage.
GATEWAY_DATABASE_URL=
GATEWAY_DATABASE_POOL_MAX=3
GATEWAY_LEASE_TTL_SECONDS=45
REQUIRE_DURABLE_AUTH=true

# Low-volume, structured lifecycle diagnostics. Never includes QR, phone,
# message bodies, JIDs or Signal key material.
WHATSAPP_DIAGNOSTICS=true

# Logging level for the internal pino logger
LOG_LEVEL=warn

# Optional: override the sessions/media directories (useful in Docker)
SESSIONS_DIR=/app/sessions
MEDIA_DIR=/app/media

# Optional: restart-on-disconnect (default true)
RECONNECT_ON_DISCONNECT=true
