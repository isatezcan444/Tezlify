{
  "name": "tezlify-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:logic": "node scripts/verify-whatsapp-logic.mjs",
    "verify:dom": "node scripts/verify-whatsapp-dom.mjs",
    "verify:merge": "node scripts/test-whatsapp-message-merge.mjs",
    "verify:realtime": "node scripts/verify-whatsapp-realtime-inbound.mjs",
    "verify:merge-equivalence": "node scripts/verify-whatsapp-merge-equivalence.mjs",
    "verify:loading-gate": "node scripts/verify-whatsapp-loading-gate.mjs",
    "verify:browser": "node scripts/verify-whatsapp-browser.mjs",
    "verify:pairing": "node scripts/verify-whatsapp-pairing.mjs",
    "verify:pairing-browser": "node scripts/verify-whatsapp-pairing-browser.mjs",
    "verify:ops-client": "node scripts/test-admin-ops-client.mjs",
    "verify:ops-dom": "node scripts/verify-admin-ops-dom.mjs",
    "audit:admin-i18n": "node scripts/audit-admin-i18n.mjs",
    "lint": "eslint src --ext .ts,.tsx --resolve-plugins-relative-to . --max-warnings 0",
    "lint:report": "eslint src --ext .ts,.tsx --resolve-plugins-relative-to .",
    "verify:dialog-a11y": "node scripts/verify-dialog-a11y-dom.mjs",
    "verify:composer-focus": "node scripts/verify-composer-focus-dom.mjs",
    "verify:emoji": "node scripts/verify-emoji-picker.mjs",
    "verify:reactions": "node scripts/verify-message-reactions-dom.mjs",
    "verify:link-preview": "node scripts/verify-link-preview-dom.mjs",
    "verify:conv-menu": "node scripts/verify-conversation-menu-dom.mjs",
    "verify:url-sync": "node scripts/verify-url-sync.mjs",
    "verify:ws-lifecycle": "node scripts/verify-ws-lifecycle.mjs",
    "verify:chat-loading": "node scripts/verify-chat-loading-lifecycle.mjs",
    "verify:older-page-lock": "node scripts/verify-older-page-lock.mjs",
    "verify:older-page-state": "node scripts/verify-older-page-state.mjs",
    "verify:message-timeout-budget": "node scripts/verify-message-timeout-budget.mjs",
    "verify:whatsapp-theme": "node scripts/verify-whatsapp-theme.mjs",
    "verify:production-whatsapp": "node scripts/verify-production-whatsapp.mjs",
    "verify:quick-reply-isolation": "node scripts/verify-quick-reply-isolation-dom.mjs",
    "verify:chat-drag-drop": "node scripts/verify-chat-drag-drop-dom.mjs",
    "verify:media-coordination": "node scripts/verify-whatsapp-media-coordination.mjs",
    "measure:whatsapp-latency": "node scripts/measure-whatsapp-latency.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
