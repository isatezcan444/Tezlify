# ==============================================================================
# Tezlify - Environment Configuration Example (Oracle Native Production)
# Copy this file to .env and configure with your environment-specific credentials.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Tezlify"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./tezlify.db"
# DATABASE_URL="postgresql+asyncpg://tezlify:your-secure-password@localhost:5432/tezlify"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0

# Demo data: seeds example campaigns/leads only into a truly empty database.
SEED_DEMO_DATA=False

# Security
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"

# Oracle Native Google OAuth Configuration
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_REDIRECT_URI="https://api.130.162.247.20.sslip.io/api/v1/auth/google/callback"
FRONTEND_ORIGIN="https://api.130.162.247.20.sslip.io"

# CORS allowlist (comma-separated). The API refuses every other Origin.
BACKEND_CORS_ORIGINS="https://api.130.162.247.20.sslip.io,http://localhost:5173"

# Anti-Ban Policy Defaults (campaign pacing configuration)
DEFAULT_MIN_DELAY_SECONDS=45
DEFAULT_MAX_DELAY_SECONDS=120
DEFAULT_TYPING_DELAY_SECONDS=4
DEFAULT_DAILY_LIMIT_PER_SESSION=50
DEFAULT_WORKING_HOURS_START="09:00"
DEFAULT_WORKING_HOURS_END="18:30"

# WhatsApp Baileys Gateway
WHATSAPP_GATEWAY_URL="http://gateway:8787"
WHATSAPP_GATEWAY_SECRET="replace-with-a-shared-secret"
WHATSAPP_GATEWAY_TIMEOUT=30

# Gateway Storage & Encryption
GATEWAY_DATABASE_URL="postgresql://tezlify:your-secure-password@postgres:5432/tezlify"
GATEWAY_ENCRYPTION_KEY="replace-with-at-least-32-random-bytes"
REQUIRE_DURABLE_AUTH=true
