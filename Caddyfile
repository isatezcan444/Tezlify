{
    auto_https disable_redirects
}

(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
        -Via
    }
}

# Domains served over the PUBLIC virtual hosts.
#
# `api.tezlify.com` was previously listed here with no `tls` directive, which
# made Caddy attempt a Let's Encrypt certificate for it. The domain has no DNS
# record, so every request-free ACME attempt failed with NXDOMAIN and Caddy
# retried on an exponential backoff for the life of the container — an endless
# stream of "level":"error" lines that buried the real operational signals and
# made the Error feed useless.
#
# Fix: the dead domain is removed. Re-add it ONLY together with a matching
# DNS A record, otherwise this exact failure comes back.
#
# NOTE ON TLS: this site deliberately does NOT pin `tls internal`. That was
# tried while chasing this error and it broke every client that trusted the
# previous Let's Encrypt chain — switching the issuing CA is a visible,
# client-wide change and is not part of fixing a dead domain. A public
# certificate needs a real A record; ACME cannot be satisfied for a name
# that only resolves through sslip.io.
api.130.162.247.20.sslip.io, 130.162.247.20.sslip.io {
    import security_headers
    encode zstd gzip

    handle /caddy-health {
        respond "OK" 200
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /ws* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /health {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /docs* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /openapi.json {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /assets/* {
        root * /srv/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}

