# ==============================================================================
# TEZLIFY — STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
#
# SAFE STAGING INVARIANTS:
# 1. DATABASE_URL must NEVER point to the production database host or IP (130.162.247.20).
# 2. WHATSAPP_AUTO_RESTORE must be "false" in staging.
# 3. GATEWAY_ENCRYPTION_KEY must be a distinct staging key, NOT the production key.
# 4. JWT_SECRET and WHATSAPP_GATEWAY_SECRET must be unique to staging.
# ==============================================================================

ENVIRONMENT=staging
STAGING_DOMAIN=staging.tezlify.io

# PostgreSQL Configuration (isolated tezlify-db-staging container)
STAGING_DB_PASSWORD=replace_with_secure_staging_password
DATABASE_URL=postgresql+asyncpg://tezlify_staging:replace_with_secure_staging_password@db:5432/tezlify_staging

# Security & Encryption Secrets (distinct from production!)
JWT_SECRET=replace_with_distinct_staging_jwt_secret_min_32_chars
WHATSAPP_GATEWAY_SECRET=replace_with_distinct_staging_gateway_secret_min_32_chars
GATEWAY_ENCRYPTION_KEY=replace_with_distinct_staging_32_byte_aes_key

# Admin & CORS
BACKEND_CORS_ORIGINS=["https://staging.tezlify.io","http://localhost:8080"]
ADMIN_DEFAULT_EMAIL=staging-admin@tezlify.local

# WhatsApp Safety (Fail-Safe Defaults)
WHATSAPP_AUTO_RESTORE=false
WHATSAPP_GATEWAY_URL=http://gateway:8787
GATEWAY_RESTORE_CONCURRENCY=1
LOG_LEVEL=info

# Ports for Staging Edge Proxy
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
